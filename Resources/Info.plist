<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Bean</string>
    <key>CFBundleDisplayName</key>
    <string>Bean</string>
    <key>CFBundleIdentifier</key>
    <string>com.bean.app</string>
    <key>CFBundleExecutable</key>
    <string>Bean</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.2.0</string>
    <key>CFBundleVersion</key>
    <string>3</string>
    <!-- App icon. The build script copies Resources/Icons/AppIcon.icns into the
         bundle when present; until a real icon is added this key simply points
         at a file that may not exist yet (harmless for a menu-bar app). -->
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundleIconName</key>
    <string>AppIcon</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <!-- LSUIElement = 1 makes Bean a menu-bar-only (agent) app with no Dock
         icon, matching the .accessory activation policy set in code. -->
    <key>LSUIElement</key>
    <true/>
    <key>NSHumanReadableCopyright</key>
    <string>© 2026 Anees Afzal and Bean contributors</string>
</dict>
</plist>
