{
  "manifest_version": 3,
  "name": "Bean — Inline Proofreading (Beta)",
  "version": "0.1.0",
  "description": "Bean inline proofreading for web text fields. Off by default; enable per site in options.",
  "permissions": ["storage", "nativeMessaging"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "options_page": "options.html",
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Bean — open settings" },
  "icons": { "128": "icon128.png" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "run_at": "document_idle",
      "js": [
        "src/localDetector.js",
        "src/issueMapping.js",
        "src/overlay.js",
        "src/contentScript.js"
      ]
    }
  ]
}
